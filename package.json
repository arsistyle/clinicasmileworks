{
  "name": "clinicasmileworks",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint --ext .astro,.ts,.js,.tsx .",
    "lint:fix": "eslint --ext .astro,.ts,.js,.tsx . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "postinstall": "[ -d '.husky' ] && husky install || true"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.0.20",
    "astro": "^4.4.13",
    "astro-seo": "^0.8.3",
    "image-compare-viewer": "^1.6.2",
    "photoswipe": "^5.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "swiper": "^11.0.7",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.43.1",
    "@astrojs/check": "^0.5.6",
    "@astrojs/react": "^3.0.10",
    "@astrojs/tailwind": "^5.1.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-astro": "0.31.4",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "husky": "^9.0.11",
    "prettier": "3.2.5",
    "prettier-plugin-astro": "0.13.0",
    "prettier-plugin-tailwindcss": "0.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2"
  }
}
