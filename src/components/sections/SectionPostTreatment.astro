---
import { TbChevronRight } from "react-icons/tb"

import { Image } from "astro:assets"
import Section from "../core/Section.astro"
import Typography from "../core/Typography/index.astro"
import Button from "../core/Button/index.astro"
---

<Section
	class="bg-white"
	containerProps={{ class: "gap-y-8 lg:gap-12 items-center min-h-96" }}
	backgroundUrl="/assets/img/pages/home/section--post-treatment.jpg"
>
	<Fragment slot="leftContent">
		<Image
			src="/assets/img/pages/home/section--post-treatment-m.jpg"
			class="mb-12 block rounded-2xl md:hidden"
			alt="Team"
			width={700}
			height={467}
			loading={"lazy"}
		/>
		<div class="mb-12 flex flex-col gap-4">
			<Typography type="h2" class="h3">Post Tratamiento</Typography>
			<Typography type="h4" class="text-primary-400"
				>Seguimiento del paciente, controles sanos</Typography
			>
			<Typography type="p"
				>Vulputate ipsum vel takimata rebum amet ut eos ipsum. Invidunt dolor velit rebum ut sit.
				Erat lorem volutpat. Ea est suscipit amet illum autem vulputate duo in hendrerit et sit
				lorem hendrerit in amet sanctus.</Typography
			>
		</div>
		<Button href="/" tag="a" variant="filled" color="dark">
			<TbChevronRight slot="iconRight" />
			Saber más
		</Button>
	</Fragment>
</Section>
