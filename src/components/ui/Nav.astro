---
import type { NavItem } from "../../constants/types";

import { TbChevronDown } from "react-icons/tb";

import { NAV_ITEMS } from "../../constants";

import ChildrenNav from "./ChildrenNav.astro";

const { pathname } = Astro.url;

const isThisPage = (pageUrl = "", currentPath = "") => {
  const paths = currentPath.replace("/", "").split("/");
  const [current] = paths;
  return pageUrl === `/${current}`;
};
---

<ul class="flex flex-col lg:flex-row lg:gap-6 h-full">
  {
    NAV_ITEMS?.map(({ href = "", label, children }: NavItem) => {
      const isActive = isThisPage(href, pathname);
      const hasChildren = Array.isArray(children);

      return (
        <li class="relative group lg:h-full lg:flex lg:items-center">
          <a
            href={href}
            class={`lg:h-full flex items-center justify-between lg:justify-start gap-2 text-center transition-colors hover:text-primary-300 px-6 py-3 lg:p-0 ${
              isActive ? "text-primary-400" : "text-white"
            }`}
          >
            <span>{label}</span>
            {hasChildren && (
              <div class="w-3 h-3"><TbChevronDown /></div>
            )}
          </a>
          {hasChildren && <ChildrenNav children={children} />}
        </li>
      );
    })
  }
</ul>
