---
import { twMerge } from "tailwind-merge"
import type { NavItem } from "../../constants/types"

const { pathname } = Astro.url

const { children } = Astro.props

const isThisPage = (pageUrl = "", currentPath = "") => {
	const paths = currentPath.replace("/", "").split("/")
	const [current] = paths
	return pageUrl === `/${current}`
}
---

<ul
	class="mb-4 bg-secondary-950/10 p-2 backdrop-blur-2xl lg:invisible lg:absolute lg:right-0 lg:top-[90%] lg:w-screen lg:min-w-48 lg:max-w-56 lg:translate-y-2 lg:rounded-2xl lg:bg-secondary-950/90 lg:px-0 lg:py-4 lg:opacity-0 lg:transition lg:delay-100 lg:group-hover:visible lg:group-hover:translate-y-0 lg:group-hover:opacity-100"
>
	{
		children?.map(({ href = "", label }: NavItem) => {
			const isActive = isThisPage(href, pathname)

			return (
				<li>
					<a
						href={href}
						class:list={twMerge(
							"flex px-4 py-3 pl-8 leading-5 text-white transition-colors hover:text-primary-300 lg:px-6 lg:py-3 lg:pl-6",
							isActive ? "text-primary-400" : ""
						)}
					>
						{label}
					</a>
				</li>
			)
		})
	}
</ul>
