---
import Menu from "../ui/Menu.astro"
import Nav from "../ui/Nav.astro"
import ButtonMenu from "../ui/ButtonMenu.astro"
import Logo from "../ui/Logo.astro"
---

<Fragment>
	<header
		class="sticky top-0 z-50 flex h-20 w-full justify-center bg-secondary-950/80 px-4 backdrop-blur-2xl"
	>
		<div class="container mx-auto flex h-full items-center justify-between">
			<a href="/" class="text-md block text-white md:text-xl">
				<Logo />
			</a>
			<div class="ml-auto hidden h-full items-center gap-4 lg:flex">
				<Nav />
			</div>
			<div class="lg:hidden"><ButtonMenu /></div>
		</div>
	</header>
	<Menu />
</Fragment>
