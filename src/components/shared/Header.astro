---
import { Image } from "astro:assets"
import Menu from "../ui/Menu.astro"
import Nav from "../ui/Nav.astro"
import ButtonMenu from "../ui/ButtonMenu.astro"
---

<header
	class="fixed left-0 right-0 top-0 flex h-20 justify-center bg-secondary-950/80 px-4 backdrop-blur-2xl"
>
	<div class="container mx-auto flex h-full items-center justify-between">
		<a href="/">
			<Image
				src="/assets/img/logo.svg"
				alt="Clinica Smile Works"
				width={258}
				height={42}
				class="hidden md:block"
			/>
			<Image
				src="/assets/img/logo-mobile.svg"
				alt="Clinica Smile Works"
				width={65}
				height={38}
				class="md:hidden"
			/>
		</a>
		<div class="ml-auto hidden h-full items-center gap-4 lg:flex">
			<Nav />
		</div>
		<Menu />
		<div class="lg:hidden"><ButtonMenu /></div>
	</div>
</header>
