---
import { Image } from "astro:assets";
import Menu from "../ui/Menu.astro";
import Nav from "../ui/Nav.astro";
import ButtonMenu from "../ui/ButtonMenu.astro";
---

<header
  class="bg-secondary-950/80 backdrop-blur-2xl fixed left-0 right-0 top-0 h-20 px-4 flex justify-center"
>
  <div class="container mx-auto flex justify-between items-center h-full">
    <a href="/">
      <Image
        src="/assets/img/logo.svg"
        alt="Clinica Smile Works"
        width={258}
        height={42}
        class="hidden md:block"
      />
      <Image
        src="/assets/img/logo-mobile.svg"
        alt="Clinica Smile Works"
        width={65}
        height={38}
        class="md:hidden"
      />
    </a>
    <div class="items-center gap-4 ml-auto hidden lg:flex h-full">
      <Nav />
    </div>
    <Menu />
    <div class="lg:hidden"><ButtonMenu /></div>
  </div>
</header>
