---
import HeaderPage from "@/components/core/HeaderPage.astro"
import Main from "@/layouts/Main.astro"

const sections: any[] = await Astro.glob("@/content/pages/tratamientos/implantologia/*.astro")

const title = "Implantología"

const breadcrumb = [
	{
		name: "Home",
		url: "/",
		type: "link",
	},
	{
		name: "Tratamientos",
		url: "/tratamientos",
		type: "link",
	},
	{
		name: title,
		type: "current",
	},
]
---

<Main title={`Clínica Smile Works | Tratamientos - ${title}`}>
	<HeaderPage
		title={title}
		breadcrumbs={breadcrumb}
		image="/pages/tratamientos/implantologia/implantes-dentales-carga-inmediata.webp"
	/>
	{sections.map((component: any) => <component.default />)}
</Main>
