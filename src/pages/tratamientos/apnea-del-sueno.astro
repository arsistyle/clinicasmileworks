---
import HeaderPage from "@/components/core/HeaderPage.astro"
import Main from "@/layouts/Main.astro"

const sections: any[] = await Astro.glob("@/content/pages/tratamientos/apnea-del-sueno/*.astro")

const title = "Apnea del sueño"
const slug = "apnea-del-sueno"

const breadcrumb = [
	{
		name: "Home",
		url: "/",
		type: "link",
	},
	{
		name: "Tratamientos",
		url: "/tratamientos",
		type: "link",
	},
	{
		name: title,
		url: `/tratamientos/${slug}`,
		type: "current",
	},
]
---

<Main title={`Clínica Smile Works | Tratamientos - ${title}`}>
	<HeaderPage
		title={title}
		breadcrumbs={breadcrumb}
		image="/pages/tratamientos/apnea-del-sueno/apnea-del-sueno-0.webp"
	/>
	{sections.map((component: any) => <component.default />)}
</Main>
