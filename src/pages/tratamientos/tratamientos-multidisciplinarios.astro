---
import HeaderPage from "@/components/core/HeaderPage.astro"
import Main from "@/layouts/Main.astro"

const sections: any[] = await Astro.glob(
	"@/content/pages/tratamientos/tratamientos-multidisciplinarios/*.astro"
)

const title = "Tratamientos Multidisciplinarios"
const slug = "tratamientos-multidisciplinarios"

const breadcrumb = [
	{
		name: "Home",
		url: "/",
		type: "link",
	},
	{
		name: "Tratamientos",
		url: "/tratamientos",
		type: "link",
	},
	{
		name: title,
		url: `/tratamientos/${slug}`,
		type: "current",
	},
]
---

<Main title={`Clínica Smile Works | Tratamientos - ${title}`}>
	<HeaderPage title={title} breadcrumbs={breadcrumb} />
	{sections.map((component: any) => <component.default />)}
</Main>
