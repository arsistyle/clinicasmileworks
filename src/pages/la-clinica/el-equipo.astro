---
import "lightgallery/css/lightgallery.css"
import "lightgallery/css/lg-zoom.css"
import "lightgallery/css/lg-thumbnail.css"

import HeaderPage from "@/components/core/HeaderPage.astro"
import Main from "@/layouts/Main.astro"
import Section from "@/components/core/Section.astro"

const title = "El equipo"
const slug = "el-equipo"

const breadcrumb = [
	{
		name: "Home",
		url: "/",
		type: "link",
	},
	{
		name: "La clínica",
		url: "/la-clinica",
		type: "link",
	},
	{
		name: title,
		url: `/el-equipo/${slug}`,
		type: "current",
	},
]
---

<Main title={`Clínica Smile Works | La clinica - ${title}`}>
	<HeaderPage title={title} breadcrumbs={breadcrumb} />
	<Section class="min-h-[500px] bg-white">
		<Fragment slot="fullContentTop"> This is a content of this page </Fragment>
	</Section>
</Main>
