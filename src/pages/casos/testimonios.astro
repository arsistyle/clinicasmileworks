---
import HeaderPage from "@/components/core/HeaderPage.astro"
import Main from "@/layouts/Main.astro"

const sections: any[] = await Astro.glob("@/content/pages/casos/testimonios/*.astro")

const title = "Testimonios"
const slug = "testimonios"

const breadcrumb = [
	{
		name: "Home",
		url: "/",
		type: "link",
	},
	{
		name: "Casos",
		url: "/casos",
		type: "link",
	},
	{
		name: title,
		url: `/casos/${slug}`,
		type: "current",
	},
]
---

<Main title={`Clínica Smile Works | Casos - ${title}`}>
	<HeaderPage title={title} breadcrumbs={breadcrumb} />
	{sections.map((component: any) => <component.default />)}
</Main>
